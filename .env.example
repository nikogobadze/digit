# ─────────────────────────────────────────────────────────────────────────────
# Digit — environment variables
#
# Local development needs NONE of these: it uses a local SQLite file (digit.db)
# and stores uploads on disk. Just run `npm start`.
#
# For production (Vercel), set these in:
#   Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Database — a hosted Turso (libSQL) database. REQUIRED in production.
# Create one at https://turso.tech, then copy its Database URL + an auth token.
DATABASE_URL=libsql://your-database-name.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# Secret used to sign login sessions (JWT). REQUIRED in production.
# Use a long random string, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-string

# Uploaded problem photos — a Vercel Blob store. OPTIONAL.
# Without it, uploads fall back to /tmp (ephemeral on serverless).
# This token is added automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=
